                            <span class="text-xs text-teal-200 font-medium">PKD KEPONG</span>
                        </div>
                        <h1 class="text-lg sm:text-xl font-bold tracking-tight text-white leading-tight">
                            Unit HIV, STI & Hepatitis C
                        </h1>
                        <p class="text-xs text-slate-300">Dashboard Perancangan & Pemantauan Program Tahunan</p>
                    </div>
                </div>

                <!-- Sync Status Indicator & Live Data Controls -->
                <div class="flex items-center justify-between md:justify-end gap-3 border-t md:border-t-0 border-white/10 pt-2 md:pt-0">
                    <div class="hidden lg:flex flex-col text-right pr-3 border-r border-white/10">
                        <span class="text-xs font-semibold text-slate-200">Ketua Unit & Pegawai Perancang</span>
                        <span class="text-[11px] text-teal-300">Sektor Kawalan Penyakit (CDC)</span>
                    </div>

                    <div id="syncStatus" class="flex items-center text-xs bg-slate-800/80 border border-slate-700/60 rounded-lg px-3 py-1.5 space-x-2">
                        <span id="syncDot" class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
                        <span id="syncText" class="text-slate-300 font-medium">Memuat Data Google Sheets...</span>
                    </div>

                    <button onclick="fetchSheetData()" class="p-2 bg-teal-600 hover:bg-teal-500 text-white rounded-lg transition text-xs font-medium flex items-center gap-1.5 shadow-sm active:scale-95">
