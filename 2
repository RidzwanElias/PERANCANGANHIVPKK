        // Published Google Sheets CSV URL
        const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vRxBdWLChEqoDXp1-A0HyjrhiSZ0cKRBf7Nh0HCdKWqSrX-gQe0nhV-DYB-PFncfoUp1TjtDZ7ABnLY/pub?gid=1377155708&single=true&output=csv';

