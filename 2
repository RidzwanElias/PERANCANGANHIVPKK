                    <div class="w-11 h-11 bg-white/10 backdrop-blur rounded-xl border border-white/20 flex items-center justify-center text-teal-400 text-xl font-bold shadow-inner">
                        <i class="fa-solid me-0.5 fa-ribbon text-red-500"></i>
                    </div>
                    <div>
