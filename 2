                        <span id="modalTarikhMula" class="font-bold text-slate-800 text-xs sm:text-sm">-</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block font-semibold uppercase text-[10px]">Tarikh Tamat</span>
                        <span id="modalTarikhTamat" class="font-bold text-slate-800 text-xs sm:text-sm">-</span>
                    </div>
                </div>

                <div class="space-y-2">
                    <div>
                        <span class="text-slate-500 font-semibold block"><i class="fa-solid fa-location-dot text-teal-600 mr-1"></i> Lokasi:</span>
                        <p id="modalLokasi" class="font-medium text-slate-800 bg-slate-50 p-2 rounded border border-slate-200">-</p>
                    </div>
                    <div>
                        <span class="text-slate-500 font-semibold block"><i class="fa-solid fa-user-doctor text-teal-600 mr-1"></i> Yang Bertanggungjawab:</span>
                        <p id="modalPIC" class="font-medium text-slate-800 bg-slate-50 p-2 rounded border border-slate-200">-</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 pt-2">
                    <div class="p-3 bg-indigo-50/70 border border-indigo-200 rounded-lg">
                        <span class="text-indigo-600 font-semibold text-[11px]">Peruntukan Bajet</span>
                        <p class="text-sm font-bold text-indigo-900 mt-0.5" id="modalBajet">-</p>
                    </div>
                    <div class="p-3 bg-emerald-50/70 border border-emerald-200 rounded-lg">
                        <span class="text-emerald-600 font-semibold text-[11px]">Perbelanjaan Sebenar</span>
                        <p class="text-sm font-bold text-emerald-900 mt-0.5" id="modalPerbelanjaan">-</p>
                    </div>
                </div>

                <div>
                    <span class="text-slate-500 font-semibold block"><i class="fa-solid fa-clipboard text-teal-600 mr-1"></i> Catatan & Objektif:</span>
                    <p id="modalCatatan" class="text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-200 leading-relaxed font-normal mt-1 min-h-[60px]">
                        -
