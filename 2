        async function fetchSheetData() {
            const syncDot = document.getElementById("syncDot");
            const syncText = document.getElementById("syncText");
            const refreshIcon = document.getElementById("refreshIcon");

            syncDot.className = "w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse";
            syncText.innerText = "Memuatkan data CSV...";
            refreshIcon.classList.add("fa-spin");

            try {
                const response = await fetch(CSV_URL, { cache: 'no-cache' });
                if (!response.ok) throw new Error("Gagal menyambung ke Google Sheets");
                
                const csvText = await response.text();
                
                Papa.parse(csvText, {
                    header: true,
                    skipEmptyLines: true,
                    complete: function(results) {
                        if (results.data && results.data.length > 0) {
                            rawProgramData = parseCSVToPrograms(results.data);
                            syncDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500";
                            syncText.innerText = "Data Terkini (Google Sheet)";
                        } else {
                            throw new Error("Data CSV kosong");
                        }
                        updateDashboard();
                    },
                    error: function(err) {
                        throw err;
                    }
                });

            } catch (error) {
                console.warn("Menggunakan data fallback tempatan akibat pautan/CORS:", error);
                rawProgramData = [...FALLBACK_PROGRAMS];
                syncDot.className = "w-2.5 h-2.5 rounded-full bg-blue-500";
                syncText.innerText = "Data Modul Tempatan (Pra-Set)";
                updateDashboard();
            } finally {
                refreshIcon.classList.remove("fa-spin");
            }
        }

        function parseCurrency(val) {
            if (val === undefined || val === null || val === "") return 0;
            const cleaned = String(val).replace(/[^0-9.-]/g, '');
            const num = parseFloat(cleaned);
            return isNaN(num) ? 0 : num;
        }

        function parseCSVToPrograms(csvRows) {
            return csvRows.map((row, index) => {
                const getVal = (keys) => {
                    for (let k of keys) {
                        const found = Object.keys(row).find(key => key.trim().toUpperCase() === k.toUpperCase());
                        if (found && row[found] !== undefined && row[found] !== "") return row[found].trim();
                    }
                    return "";
                };

                const nama = getVal(["Nama Program", "Program", "Aktiviti", "Nama Aktiviti", "Tajuk"]) || `Program ${index + 1}`;
                const kategoriRaw = getVal(["Kategori", "Unit", "Jenis", "Fokus"]) || "HIV";
                
                let kategori = "HIV";
                if (kategoriRaw.toUpperCase().includes("STI")) kategori = "STI";
                else if (kategoriRaw.toUpperCase().includes("HEP")) kategori = "Hep C";
                else if (kategoriRaw.toUpperCase().includes("GABUNGAN") || kategoriRaw.toUpperCase().includes("AM") || kategoriRaw.toUpperCase().includes("LATIHAN")) kategori = "Gabungan";

                const bulan = getVal(["Bulan", "Month"]) || "Januari";
                const tarikhMula = getVal(["Tarikh Mula", "Mula", "Start Date", "Tarikh"]) || "-";
                const tarikhTamat = getVal(["Tarikh Tamat", "Tamat", "End Date"]) || tarikhMula;

                const lokasi = getVal(["Lokasi", "Tempat", "Venue"]) || "PKD Kepong";
                const pic = getVal(["YANG BERTANGGUNGJAWAB", "Yang Bertanggungjawab", "Bahagian Bertanggungjawab", "Bahagian", "Unit", "Pegawai", "PIC", "Pegawai Bertanggungjawab", "Penyelaras"]) || "Unit CDC Kepong";
                
                const sasaran = parseInt(parseCurrency(getVal(["Sasaran", "Target", "Bil Sasaran", "Jumlah Sasaran"]))) || 100;
                const capaian = parseInt(parseCurrency(getVal(["Capaian", "Pencapaian", "Peserta", "Actual"]))) || 0;
                
                const bajet = parseCurrency(getVal(["BAJET", "Bajet", "Peruntukan", "Bajet (RM)", "Jumlah Bajet", "PERUNTUKAN BAJET", "RM"]));
                const perbelanjaan = parseCurrency(getVal(["PERBELANJAAN", "Perbelanjaan", "Kos", "Kos Perbelanjaan", "Terbelanja", "Belanja"]));

                const statusRaw = getVal(["STATUS", "Status", "Pelaksanaan", "Keadaan"]) || "Dalam Perancangan";

                const catatan = getVal(["Catatan", "Nota", "Objektif", "Keterangan"]) || "Tiada catatan tambahan.";

                return {
                    id: index + 1,
                    nama,
                    kategori,
                    bulan,
                    tarikhMula,
                    tarikhTamat,
                    lokasi,
                    pic,
                    sasaran,
                    capaian,
                    bajet,
                    perbelanjaan,
                    status: statusRaw,
                    catatan
                };
            });
        }

        function updateStatusFilterDropdown() {
            const statusSelect = document.getElementById("filterStatus");
            const currentSelected = statusSelect.value;
            
            const uniqueStatuses = Array.from(new Set(rawProgramData.map(d => d.status).filter(Boolean)));
            
            let html = '<option value="ALL">Semua Status (Lajur STATUS)</option>';
            uniqueStatuses.forEach(st => {
                html += `<option value="${escapeHtml(st)}">${escapeHtml(st)}</option>`;
            });
            
            statusSelect.innerHTML = html;
            if (uniqueStatuses.includes(currentSelected)) {
                statusSelect.value = currentSelected;
            } else {
                statusSelect.value = "ALL";
            }
        }

        function applyFilters() {
            const searchVal = document.getElementById("searchInput").value.toLowerCase();
            const kategoriVal = document.getElementById("filterKategori").value;
            const statusVal = document.getElementById("filterStatus").value;

            filteredData = rawProgramData.filter(item => {
                const matchesSearch = item.nama.toLowerCase().includes(searchVal) ||
                                      item.lokasi.toLowerCase().includes(searchVal) ||
                                      item.pic.toLowerCase().includes(searchVal);

                const matchesKategori = (kategoriVal === "ALL") || (item.kategori === kategoriVal);
                const matchesStatus = (statusVal === "ALL") || (item.status === statusVal);

                return matchesSearch && matchesKategori && matchesStatus;
            });

            renderDashboardComponents();
        }

        function initSearchAndFilters() {
            document.getElementById("searchInput").addEventListener("input", applyFilters);
            document.getElementById("filterKategori").addEventListener("change", applyFilters);
            document.getElementById("filterStatus").addEventListener("change", applyFilters);
        }

        function resetFilters() {
            document.getElementById("searchInput").value = "";
            document.getElementById("filterKategori").value = "ALL";
            document.getElementById("filterStatus").value = "ALL";
            applyFilters();
        }

        function updateDashboard() {
            updateStatusFilterDropdown();
            filteredData = [...rawProgramData];
            applyFilters();
        }

        function renderDashboardComponents() {
            const totalProg = filteredData.length;
            
            const isCompleted = (s) => {
                if (!s) return false;
                const lower = s.toLowerCase();
                return (lower.includes("selesai") || lower.includes("tamat") || lower.includes("done")) && !lower.includes("belum");
            };

            const completedProg = filteredData.filter(d => isCompleted(d.status)).length;
            const completionRate = totalProg > 0 ? Math.round((completedProg / totalProg) * 100) : 0;

            const pendingProg = totalProg - completedProg;
            const pendingRate = totalProg > 0 ? Math.round((pendingProg / totalProg) * 100) : 0;

            const totalBudget = filteredData.reduce((sum, d) => sum + d.bajet, 0);

            document.getElementById("kpiTotalProg").innerText = totalProg;
            document.getElementById("kpiCompleted").innerText = completedProg;
            document.getElementById("kpiCompletionRate").innerText = `${completionRate}%`;
            document.getElementById("kpiProgressBar").style.width = `${completionRate}%`;

            document.getElementById("kpiPendingCount").innerText = pendingProg;
            document.getElementById("kpiPendingSubtext").innerText = `${pendingProg} program`;
            document.getElementById("kpiPendingBar").style.width = `${pendingRate}%`;

            document.getElementById("kpiTotalBudget").innerText = `RM ${totalBudget.toLocaleString()}`;

            document.getElementById("recordCounter").innerText = `Menampilkan ${filteredData.length} daripada ${rawProgramData.length} program`;

            renderCharts();
            renderTable();
        }

        function renderCharts() {
            const statusCounts = {};
            filteredData.forEach(d => {
                const st = d.status || "Tiada Status";
                statusCounts[st] = (statusCounts[st] || 0) + 1;
            });

            const paletteColors = ['#10B981', '#3B82F6', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899', '#64748B'];

            if (chartsInstance.status) chartsInstance.status.destroy();
            const ctxStatus = document.getElementById("statusChart").getContext("2d");
            chartsInstance.status = new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(statusCounts),
                    datasets: [{
                        data: Object.values(statusCounts),
                        backgroundColor: paletteColors.slice(0, Object.keys(statusCounts).length),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    },
                    cutout: '65%'
                }
            });

            const bahagianCounts = {};
            filteredData.forEach(d => {
                const bhg = d.pic || "Lain-lain";
                bahagianCounts[bhg] = (bahagianCounts[bhg] || 0) + 1;
            });

            const bhgLabels = Object.keys(bahagianCounts);
            const bhgData = Object.values(bahagianCounts);
            const bhgColors = ['#0284C7', '#7C3AED', '#0D9488', '#D90429', '#F59E0B', '#10B981', '#6366F1', '#EC4899', '#64748B'];

            if (chartsInstance.kategori) chartsInstance.kategori.destroy();
            const ctxKategori = document.getElementById("kategoriChart").getContext("2d");
            chartsInstance.kategori = new Chart(ctxKategori, {
                type: 'bar',
                data: {
                    labels: bhgLabels,
                    datasets: [{
                        label: 'Bilangan Program',
                        data: bhgData,
                        backgroundColor: bhgColors.slice(0, bhgLabels.length),
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } } },
                        x: { 
                            ticks: { 
                                font: { size: 10 },
                                callback: function(val) {
                                    let label = this.getLabelForValue(val);
                                    return label.length > 14 ? label.substring(0, 14) + '...' : label;
                                }
                            } 
                        }
                    }
                }
            });
        }

