                </div>
                <div class="w-full bg-slate-100 rounded-full h-1.5 mt-1 overflow-hidden">
                    <div id="kpiProgressBar" class="bg-emerald-500 h-1.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
            </div>

            <!-- Card 3: Pending Programs -->
            <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex flex-col justify-between hover:shadow-md transition">
                <div class="flex items-center justify-between">
