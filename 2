        const FALLBACK_PROGRAMS = [
            {
                id: 1,
                nama: "Kempen Saringan HIV Kendiri & STI Komuniti PPR Batu Muda",
                kategori: "HIV",
                bulan: "Februari",
                tarikhMula: "2026-02-15",
                tarikhTamat: "2026-02-16",
                lokasi: "Dewan Orang Ramai PPR Batu Muda, Kepong",
                pic: "Dr. Nurul Huda / PPKP Ahmad",
                sasaran: 250,
